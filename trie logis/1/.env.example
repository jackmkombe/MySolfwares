# Configuration de l'application
# Copiez ce fichier en .env et modifiez les valeurs selon vos besoins

# Algorithmes
ALGO_TITLE_WEIGHT=0.5
ALGO_STRUCTURAL_WEIGHT=0.3
ALGO_TEMPORAL_WEIGHT=0.1
ALGO_QUALITY_WEIGHT=0.1
ALGO_HIGH_CONFIDENCE_THRESHOLD=0.85
ALGO_AMBIGUOUS_MIN_THRESHOLD=0.5

# Système de fichiers
FS_EXCLUDE_HIDDEN=true
FS_RECURSIVE_BY_DEFAULT=true

# Interface utilisateur
UI_MIN_WINDOW_WIDTH=1200
UI_MIN_WINDOW_HEIGHT=800

# Application
APP_NAME="Tri et Fusion Intelligente"
APP_VERSION="1.0.0"
APP_LOG_LEVEL="INFO"
